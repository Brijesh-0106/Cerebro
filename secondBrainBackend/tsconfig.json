{
    "compilerOptions": {
        "rootDir": "src",
        "outDir": "dist",
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "target": "ES2020",
        "moduleResolution": "node",
        "module": "ES2020",
        "esModuleInterop": true //allow default import
    }
}